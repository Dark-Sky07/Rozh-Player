{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ROZH Player",
  "version": "1.1.2",
  "identifier": "app.rozh.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ROZH Player",
        "width": 1320,
        "height": 840,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost blob: data:; img-src 'self' asset: http://asset.localhost blob: data: https: content:; media-src 'self' asset: http://asset.localhost blob: data: https: http: content:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data: https: http:; worker-src 'self' blob:; child-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "A fast, beautiful, universal media player",
    "longDescription": "ROZH Player plays video, audio and live streams on Windows, macOS, Linux, Android and Android TV. Subtitles, HLS/DASH, equalizer and a native FFmpeg fallback for exotic formats.",
    "copyright": "\u00a9 2026 ROZH. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "bin/"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "section": "video",
        "files": {}
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "exceptionDomain": ""
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1001002
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBRUYyN0MzQkNDNUEwNDQKUldSRW9NVzh3eWZ2V29kUGRTNldwODlDL2RlTVVTdE1vai9HMUN0Z0N0RVZhNWJLMVZWWjBMNmQK",
      "endpoints": [
        "https://github.com/Dark-Sky07/Rozh-Player/releases/latest/download/latest.json"
      ]
    }
  }
}
